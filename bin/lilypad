#!/usr/bin/env bash
# Lilypad CLI. Guide: README.md in the lilypad-cli repo
#
#   lilypad auth <email> [--new]              email yourself your 30-day key (--new replaces it)
#   lilypad login <key>                       save the key to ~/.config/lilypad/key (mode 600)
#   lilypad config url <URL>                  set the platform URL (the installer asks for it)
#   lilypad update                            reinstall the latest version
#   lilypad --how-to                          step-by-step guide: deploy a demo, use the tool
#   lilypad logout                            delete the saved key
#   lilypad whoami                            your email, key expiry, role
#   lilypad list [--client C]                 demos not yet destroyed, optionally one client's
#   lilypad setup [<name>] [--conf FILE] [--repo <url>] [--client C] [--branch B] [--port N]
#                  [--health /path] [--size tiny|small|medium|large] [--env-file FILE]
#                                             save config (GitHub access from $GITHUB_AUTH or a hidden prompt:
#                                             a PAT, a deploy key file path, or "public")
#   lilypad setup --sample                    print a sample conf file: lilypad setup --sample > demoproject.conf
#   lilypad create|redeploy|status|extend|destroy <name>   (deploy = create)
#   lilypad logs <name> [lines]               app (container) logs; default 50, max 500
#   lilypad build-logs <name> [lines]         latest build log, running or finished; default 50, max 500
#   lilypad pin|unpin <name>                  admins: make permanent (no expiry, not destroyable), or undo
#   lilypad '<json>' | lilypad -            raw JSON body (JSON as an argument, or on stdin)
#   lilypad <command> --help                  what a command does and the options it takes
#
# Key: $LILYPAD_KEY, else ~/.config/lilypad/key. URL: $LILYPAD_URL, else ~/.config/lilypad/url.
set -euo pipefail

VERSION="1.2.0"

usage() {
  sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

how_to() {
  cat <<'EOT'
Lilypad: how to deploy a demo

Lilypad builds a GitHub repo (it needs a Dockerfile) and serves it at https://<name>.<the platform's demo domain>,
or https://<name>-<client>.<the platform's demo domain> when you give a client.
Demos are deleted after 30 days.

1. One-time setup
  The installer saved the platform URL. Check or change it:
      lilypad config url <URL>       # https only; $LILYPAD_URL overrides

2. Get an access key (your company email is your identity)
      lilypad auth you@lftechnology.com    # exact address, no + aliases
      lilypad login lpk_...                # paste the key from the email (check spam/junk too)
      lilypad whoami                       # shows your email, key expiry, role
  Lost the email or on another machine? Run auth again: it sends the same key while it is valid.
  Add --new only to replace the key (for example if it leaked); every saved copy then stops working.

3. Prepare the repo
   - Dockerfile at the repo root (the branch you deploy).
   - The app listens on one port (default 8080).
   - A health path returns 200-399 without a login (default /). If the app is behind a login,
     add an open /health route.
   - No real secrets in env vars: operators can see them. Auth is the app's own job.

4. Give Lilypad read access to the repo (one of three)
   - Public repo: nothing to create. Use the word public.
   - Deploy key: ssh-keygen -t ed25519 -N "" -f ~/.ssh/lilypad_shop, add lilypad_shop.pub under
     the repo's Settings > Deploy keys (read-only), and pass the private key file's path.
   - Fine-grained PAT: read-only "Contents" on that one repo.
   Give it to the CLI via the environment or the hidden prompt, never as an option:
      export GITHUB_AUTH=public                    (or)
      export GITHUB_AUTH=~/.ssh/lilypad_shop       (or)
      export GITHUB_AUTH=github_pat_...

5. Save the demo's configuration (nothing is deployed yet)
   Easiest: keep the settings in a conf file.
      lilypad setup --sample > demoproject.conf     # a documented template
      (edit demoproject.conf: NAME, REPO, PORT, HEALTH, SIZE, ...)
      lilypad setup --conf demoproject.conf
   Or give everything as options (these override the file):
      lilypad setup shop --client acme --repo https://github.com/<org>/<repo> \
        --port 3000 --health /health --size small [--branch main] [--env-file app.env]
   GitHub access is never read from the conf file (step 4).
   Name (the project): 3-24 chars, lowercase letters, digits, hyphens, starts with a letter.
   Client (optional): 1-20 chars, lowercase letters, digits, hyphens. The address becomes
   <name>-<client> (shop-acme) and every resource is tagged Client=acme. Fixed once deployed.
   Size: tiny (default), small, medium (large is admin-only).
   Then check it: lilypad status acme-poc   # expect "Repo readable, Dockerfile found"

6. Deploy
      lilypad create acme-poc
   Takes 5-10 minutes. You get one email when it is live, or one if it fails.
   Follow along with: lilypad status acme-poc   # RUNNING + settled means ready

7. Change something
   - New code: push it, then  lilypad redeploy acme-poc
   - New settings: edit the conf file and run setup again (or repeat EVERY option you want to keep), then redeploy.

8. When it fails or misbehaves
      lilypad status acme-poc | jq -r .message
      lilypad build-logs acme-poc 200   # the build: clone, docker build, push
      lilypad logs acme-poc 200         # the running app
   Check that --port matches the container and --health returns 200-399 without a login.
   A failed demo's status has a `Last failure:` line with the cause. Fix it, then
   lilypad redeploy acme-poc (it also retries a FAILED demo).

9. Lifecycle
      lilypad list                 # your demos, any status but destroyed
      lilypad extend acme-poc      # expiry = now + 30 days (90 days total at most)
      lilypad destroy acme-poc     # permanent; the name is free for anyone afterwards
   A warning email arrives on day 27. At most 5 active demos per person (25 for sales, 50 for elite and admins).

More: lilypad --help, lilypad <command> --help.
EOT
}

# Prints the sample conf file (same text as demoproject.sample.conf).
sample_conf() {
  cat <<'EOT'
# Lilypad demo configuration (.env style: KEY=VALUE, one per line, # starts a comment).
# Save as demoproject.conf, edit, then run:
#
#   lilypad setup --conf demoproject.conf
#
# Command-line options override the same key here. GitHub access is NOT set in this file:
# export GITHUB_AUTH=... (a PAT, a deploy key file path, or public) or type it at the hidden prompt.

# Project name: 3-24 chars, lowercase letters, digits, hyphens; starts with a letter.
NAME=acme-poc

# Required. The repo to build (needs a Dockerfile at the root).
REPO=https://github.com/your-org/your-repo

# Optional client, 1-20 chars (lowercase letters, digits, hyphens). The address becomes
# <name>-<client> and the demo is tagged Client=<client>. Fixed after the first deploy.
# CLIENT=acme

BRANCH=main
PORT=8080

# A path that returns 200-399 without a login.
HEALTH=/

# tiny | small | medium | large (large is admin-only)
SIZE=tiny

# Optional file of KEY=VALUE environment variables for the demo itself (no real secrets).
# A relative path is relative to this file. Leave it out to clear the demo's env vars.
# ENV_FILE=app.env

# Optional notes for your own record, up to 1000 characters: who it is for, dates, demo tips.
# Shown in full by status, shortened in list. Kept when left out; NOTES="" clears them.
# Write \n for a line break. Not for passwords.
# NOTES="Acme pilot. Demo on 30 Oct\nLogin with the guest button"
EOT
}

# Reads a .env-style conf file for `setup` into c_* variables and c_seen. The file is parsed as
# text and never sourced or evaluated.
read_conf() { # read_conf <file>
  local file="$1" line n=0 key val q rest after
  [ -r "$file" ] || die "cannot read $file"
  c_seen=" "
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="${line%$'\r'}"
    if [ "$n" -eq 1 ]; then line="${line#$'\xef\xbb\xbf'}"; fi
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    case "$line" in '' | '#'*) continue ;; esac
    case "$line" in export[[:space:]]*) line="${line#export}"; line="${line#"${line%%[![:space:]]*}"}" ;; esac
    case "$line" in *=*) ;; *) die "$file:$n: expected KEY=VALUE" ;; esac
    key="${line%%=*}"
    key="${key%"${key##*[![:space:]]}"}"
    val="${line#*=}"
    val="${val#"${val%%[![:space:]]*}"}"
    case "$key" in '' | *[!A-Za-z0-9_]*) die "$file:$n: '$key' is not a valid key name" ;; esac
    case "$val" in
      \"* | \'*)
        q="${val:0:1}"
        rest="${val:1}"
        case "$rest" in *"$q"*) ;; *) die "$file:$n: missing closing quote for $key" ;; esac
        after="${rest#*"$q"}"
        val="${rest%%"$q"*}"
        after="${after#"${after%%[![:space:]]*}"}"
        case "$after" in '' | '#'*) ;; *) die "$file:$n: unexpected text after the closing quote for $key" ;; esac
        ;;
      '#'*) val="" ;;
      *)
        case "$val" in *[[:space:]]'#'*) val="${val%%[[:space:]]#*}" ;; esac
        val="${val%"${val##*[![:space:]]}"}"
        ;;
    esac
    case "$c_seen" in *" $key "*) die "$file:$n: $key is set twice" ;; esac
    c_seen="$c_seen$key "
    case "$key" in
      NAME) c_name="$val" ;;
      REPO) c_repo="$val" ;;
      CLIENT) c_client="$val" ;;
      BRANCH) c_branch="$val" ;;
      PORT) c_port="$val" ;;
      HEALTH) c_health="$val" ;;
      SIZE) c_size="$val" ;;
      ENV_FILE) c_env_file="$val" ;;
      NOTES) c_notes="$val" ;;
      GITHUB_AUTH | GITHUB_PAT | PAT | GITHUB_TOKEN | DEPLOY_KEY)
        die "$file:$n: GitHub access cannot be set in a conf file; use \$GITHUB_AUTH or the hidden prompt" ;;
      *) die "$file:$n: unknown key $key (supported: NAME REPO CLIENT BRANCH PORT HEALTH SIZE ENV_FILE NOTES)" ;;
    esac
  done <"$file"
}

# Per-command help: `lilypad <command> --help` or `lilypad help <command>`. Printed to stdout, exit 0.
command_help() {
  case "$1" in
    auth) cat <<'EOT'
lilypad auth <email> [--new]

Email yourself your 30-day access key. Do this once, then run `lilypad login <key>`.

  <email>   your @lftechnology.com address, exactly (no + aliases). Checked locally first:
            another domain is rejected without contacting the platform.
  --new     replace your key: every saved copy (other machines, the web client) stops working.
            Use it if the key leaked. Without it you get your current key again while it is valid.

One email per address per minute.
The email comes from "Lilypad" with subject "Your Lilypad access key". If it is not in your
inbox within a minute, check your spam/junk folder.
EOT
      ;;
    login) cat <<'EOT'
lilypad login <key>

Save the key from the email to ~/.config/lilypad/key (mode 600). Later commands send it.
Local only: nothing is sent to the platform.

  <key>     the key from the email, starts with lpk_

$LILYPAD_KEY overrides the saved file (handy in CI).
EOT
      ;;
    config) cat <<'EOT'
lilypad config url <URL>

Set the platform URL (https only) and save it to ~/.config/lilypad/url (mode 600).
Local only. The installer asks for this URL; use this command to change it later.
$LILYPAD_URL overrides the saved file.
EOT
      ;;
    update) cat <<'EOT'
lilypad update

Reinstall the latest version of this CLI. Your key and URL are kept.
EOT
      ;;
    logout) cat <<'EOT'
lilypad logout

Delete the saved key. Local only. The key itself stays valid until it expires or is replaced.
EOT
      ;;
    whoami) cat <<'EOT'
lilypad whoami

Show the email your key belongs to, when the key expires, your role (user, sales, elite or admin)
and how many active demos you may have. No options.
EOT
      ;;
    list) cat <<'EOT'
lilypad list [--client <client>]

List your demos (admins: everyone's) that are not destroyed: set up, building, live or failed, with client, owner, status, expiry and estimated
monthly cost, plus the total for the live ones.

Options:
  --client <client>   only that client's demos
EOT
      ;;
    setup) cat <<'EOT'
lilypad setup [<name>] [--conf <file>] [options]
lilypad setup --sample

Save a demo's configuration. Nothing is deployed: run `lilypad create <name>` afterwards.
The repo and Dockerfile are checked in the background; poll `lilypad status <name>` for the result.
Rerunning setup REPLACES the whole config: repeat every option you want to keep. Only the
GitHub access is carried over when left blank, except on a destroyed name (fresh start).

  <name>              project name, 3 to 24 chars: lowercase letters, digits, hyphens; starts
                      with a letter. Served at https://<name>.<the platform's demo domain>

Options:
  --repo <url>        required (or REPO in the conf file). https://github.com/<org>/<repo>
  --client <client>   optional client, 1 to 20 chars: lowercase letters, digits, hyphens.
                      The address becomes <name>-<client> and every resource is tagged
                      Client=<client>. Can change until the first deploy; after that it is
                      fixed (destroy and set up again). Omit to keep it.
  --branch <name>     branch to build. Default: main
  --port <n>          port your container listens on, 1 to 65535. Default: 8080
  --health <path>     path that returns 200 to 399 without a login. Default: /
  --size <size>       tiny 256/512 (default), small 512/1024, medium 1024/2048,
                      large 2048/4096 (CPU units / MiB). large is admin-only.
  --env-file <file>   KEY=VALUE per line, keys match [A-Z_][A-Z0-9_]*. Visible to anyone with
                      the platform operators, so no real secrets. Omit to clear.
  --notes <text>      your own notes about the demo, up to 1000 chars (\n for a line break).
                      Shown in full by status, shortened in list. Omit to keep the stored
                      notes; --notes "" clears them. Visible to admins: no passwords.

Conf file (--conf <file>):
  Keep the options in a .env-style file: one KEY=VALUE per line, # starts a comment, values may
  be quoted. Keys: NAME REPO CLIENT BRANCH PORT HEALTH SIZE ENV_FILE NOTES (the options above;
  ENV_FILE is --env-file, a relative path is relative to the conf file). The file is read as
  text, never run. Unknown or repeated keys are errors. GitHub access is NOT a conf key.
  A command-line option beats the same key in the file; <name> beats NAME.
  --sample            print a documented sample conf:  lilypad setup --sample > demoproject.conf

GitHub access (one of three; Lilypad works out which):
  public                      a public repo, no credential
  <path to a private key>     a deploy key: the private half (no passphrase) of a key whose .pub is
                              under the repo's Settings > Deploy keys. Make one with
                              ssh-keygen -t ed25519 -N "" -f ~/.ssh/lilypad_shop
  github_pat_...              a fine-grained PAT, read-only Contents on that one repo
  Set $GITHUB_AUTH ($GITHUB_PAT also works), or type it at the hidden prompt. It is never taken as an
  option, so it stays out of shell history and `ps`. Blank keeps the stored one; required on first
  setup and on any setup of a destroyed name, even your own.

Example:
  GITHUB_AUTH=public lilypad setup shop --client acme \
    --repo https://github.com/your-org/shop --port 3000 --health /health --size tiny
  GITHUB_AUTH=~/.ssh/lilypad_shop lilypad setup --conf demoproject.conf
  GITHUB_AUTH=github_pat_... lilypad setup --conf demoproject.conf
EOT
      ;;
    create|deploy) cat <<'EOT'
lilypad create <name>      (alias: lilypad deploy <name>)

Build the repo's image and create the demo's stack. Run `setup` first. Asynchronous: the reply
only says "accepted". You get one email when it is live, or one if it fails.

  <name>    the demo name used in setup

Usually takes 5 to 10 minutes. Poll with `lilypad status <name>`. Creator or admin (the creator
gets a note when an admin does it). Up to 5 active demos per person (25 for sales, 50 for elite and admins).
EOT
      ;;
    redeploy) cat <<'EOT'
lilypad redeploy <name>

Rebuild the latest commit of the configured branch, roll the service, and apply config changes
made with `setup`. Asynchronous; one email when it is updated, or one if it fails. Creator or admin.
Also retries a FAILED demo (builds and creates it again).

  <name>    the demo name used in setup
EOT
      ;;
    status) cat <<'EOT'
lilypad status <name>

Show state (BUILDING, DEPLOYING, RUNNING, ...), URL, owner, commit, size, expiry, estimated cost
(per month and so far, at list prices), task counts and whether it has settled. Read the text alone with:  lilypad status <name> | jq -r .message
A failed demo shows `Last failure:` with the cause (for example failed health checks).
Creator or admin.

  <name>    the demo name
EOT
      ;;
    logs) cat <<'EOT'
lilypad logs <name> [lines]

Print the latest log lines of the running app (its container). Build output is
build-logs. After a failed deployment the first line is the failure cause. Creator or admin.

  <name>    the demo name
  [lines]   how many lines. Default: 50, max: 500
EOT
      ;;
    build-logs) cat <<'EOT'
lilypad build-logs <name> [lines]

Print the latest build's log (clone, docker build, push), whether it is still running,
succeeded or failed, plus its status and times. App output is logs. Creator or admin.
Logs are kept 7 days.

  <name>    the demo name
  [lines]   how many lines. Default: 50, max: 500
EOT
      ;;
    extend) cat <<'EOT'
lilypad extend <name>

Move the expiry to 30 days from now. Total lifetime is capped at 90 days. Creator or admin.

  <name>    the demo name
EOT
      ;;
    pin | unpin) cat <<'EOT'
lilypad pin <name>
lilypad unpin <name>

Admins only. pin makes a running demo permanent: no expiry, no warning email, and nobody can
destroy it until it is unpinned. It does not count toward its creator's cap, and redeploy keeps it
permanent. unpin puts it back on a normal 30-day lifetime. Asynchronous; check with status.

  <name>    the demo name
EOT
      ;;
    destroy) cat <<'EOT'
lilypad destroy <name>

Delete the demo's stack and images. Asynchronous; finishes in a minute or two, and the name is
then free for anyone. Cannot be undone. Creator or admin.

  <name>    the demo name
EOT
      ;;
    -) cat <<'EOT'
lilypad -        (or: lilypad '<json>')

Send a raw JSON body, read from stdin or given as the argument. Use stdin when the body holds a
secret: an argument is visible in `ps`.

  lilypad '{"action":"logs","name":"acme-poc","args":{"lines":100}}'
  jq -Rs '{action:"setup",name:"acme-poc",args:{repoUrl:"...",githubPat:"...",env:.}}' app.env | lilypad -
EOT
      ;;
    *) die "no help for '$1' (see: lilypad --help)" ;;
  esac
}

die() {
  echo "lilypad: $*" >&2
  exit 1
}

need_jq() { command -v jq >/dev/null || die "jq is required for this command"; }

case "${1:-}" in --how-to | how-to) how_to; exit 0 ;; esac
case "${1:-}" in --version | -V) echo "lilypad $VERSION"; exit 0 ;; esac

[ $# -ge 1 ] || usage

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/lilypad"
key_file="$config_dir/key"
url_file="$config_dir/url"
email_domain="${LILYPAD_EMAIL_DOMAIN:-lftechnology.com}"
action="$1"
shift

# `lilypad help <command>` and `lilypad <command> --help` print that command's help.
if [ "$action" = help ] && [ $# -ge 1 ]; then
  command_help "$1"
  exit 0
fi
case "${1:-}" in -h | --help) command_help "$action"; exit 0 ;; esac

[ "$action" = deploy ] && action=create

case "$action" in
  -h | --help | help) usage ;;
  login)
    [ $# -eq 1 ] || usage
    case "$1" in lpk_*) ;; *) die "that does not look like a demo key (lpk_...)" ;; esac
    mkdir -p "$(dirname "$key_file")"
    (umask 077 && printf '%s\n' "$1" >"$key_file")
    echo "key saved to $key_file"
    exit 0
    ;;
  setup)
    if [ "${1:-}" = "--sample" ]; then
      [ $# -eq 1 ] || usage
      sample_conf
      exit 0
    fi
    ;;
  logout)
    rm -f "$key_file"
    echo "key removed"
    exit 0
    ;;
  config)
    [ $# -eq 2 ] && [ "$1" = url ] || usage
    case "$2" in https://?*) ;; *) die "the URL must start with https://" ;; esac
    case "$2" in *[[:space:]\"]*) die "the URL must not contain spaces or quotes" ;; esac
    mkdir -p "$config_dir"
    (umask 077 && printf '%s\n' "$2" >"$url_file")
    echo "URL saved to $url_file"
    exit 0
    ;;
  update)
    [ $# -eq 0 ] || usage
    src_file="$config_dir/source"
    [ -r "$src_file" ] || die "no install source recorded; reinstall with the installer"
    src="$(cat "$src_file")"
    case "$src" in https://?*) ;; *) die "install source in $src_file is not an https URL" ;; esac
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT
    curl -fsSL "$src/install.sh" -o "$tmp" || die "could not download $src/install.sh"
    LILYPAD_BASE_URL="$src" bash "$tmp" --upgrade
    exit 0
    ;;
esac

# --- build the JSON body -------------------------------------------------------

case "$action" in
  -) body="$(cat)" ;;
  '{'*) body="$action" ;;
  auth)
    new=false
    args=()
    for a in "$@"; do
      if [ "$a" = --new ]; then new=true; else args+=("$a"); fi
    done
    [ ${#args[@]} -eq 1 ] || usage
    set -- "${args[@]}"
    # Same rule as the platform, checked here so a wrong address never reaches the platform.
    email="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
    printf '%s' "$email" | grep -Eq "^[a-z0-9][a-z0-9._-]{0,63}@${email_domain//./\\.}\$" ||
      die "'$1' is not allowed: use your plain @$email_domain address (no + aliases, no other domain)"
    need_jq
    body="$(jq -nc --arg email "$email" --argjson new "$new" '{action: "auth", email: $email} + (if $new then {new: true} else {} end)')"
    ;;
  whoami)
    [ $# -eq 0 ] || usage
    need_jq
    body="$(jq -nc --arg a "$action" '{action: $a}')"
    ;;
  list)
    client=""
    if [ $# -gt 0 ]; then
      [ $# -eq 2 ] && [ "$1" = "--client" ] || usage
      client="$2"
    fi
    need_jq
    body="$(jq -nc --arg c "$client" '{action: "list"} + (if $c == "" then {} else {args: {client: $c}} end)')"
    ;;
  create | redeploy | status | extend | destroy | pin | unpin)
    [ $# -eq 1 ] || usage
    need_jq
    body="$(jq -nc --arg a "$action" --arg n "$1" '{action: $a, name: $n}')"
    ;;
  logs | build-logs)
    [ $# -ge 1 ] && [ $# -le 2 ] || usage
    need_jq
    body="$(jq -nc --arg a "$action" --arg n "$1" --arg l "${2:-}" \
      '{action: $a, name: $n} + (if $l == "" then {} else {args: {lines: $l}} end)')"
    ;;
  setup)
    [ $# -ge 1 ] || usage
    need_jq
    name="" conf=""
    repo="" client="" branch="" port="" health="" size="" env_file="" notes=""
    o_seen=" "
    case "$1" in -*) ;; *) name="$1"; o_seen=" name "; shift ;; esac
    while [ $# -gt 0 ]; do
      [ $# -ge 2 ] || die "$1 needs a value"
      case "$1" in
        --conf) conf="$2" ;;
        --repo) repo="$2"; o_seen="$o_seen""repo " ;;
        --client) client="$2"; o_seen="$o_seen""client " ;;
        --branch) branch="$2"; o_seen="$o_seen""branch " ;;
        --port) port="$2"; o_seen="$o_seen""port " ;;
        --health) health="$2"; o_seen="$o_seen""health " ;;
        --size) size="$2"; o_seen="$o_seen""size " ;;
        --env-file) env_file="$2"; o_seen="$o_seen""env_file " ;;
        --notes) notes="$2"; o_seen="$o_seen""notes " ;;
        *) die "unknown option $1 (see: lilypad --help)" ;;
      esac
      shift 2
    done
    if [ -n "$conf" ]; then
      c_name="" c_repo="" c_client="" c_branch="" c_port="" c_health="" c_size="" c_env_file="" c_notes="" c_seen=" "
      read_conf "$conf"
      # Command-line options beat the file.
      case "$o_seen" in *" name "*) ;; *) name="$c_name" ;; esac
      case "$o_seen" in *" repo "*) ;; *) repo="$c_repo" ;; esac
      case "$o_seen" in *" client "*) ;; *) client="$c_client" ;; esac
      case "$o_seen" in *" branch "*) ;; *) branch="$c_branch" ;; esac
      case "$o_seen" in *" port "*) ;; *) port="$c_port" ;; esac
      case "$o_seen" in *" health "*) ;; *) health="$c_health" ;; esac
      case "$o_seen" in *" size "*) ;; *) size="$c_size" ;; esac
      case "$o_seen$c_seen" in *" notes "*) ;; *" NOTES "*) notes="$c_notes"; o_seen="$o_seen""notes " ;; esac
      case "$o_seen" in
        *" env_file "*) ;;
        *)
          env_file="$c_env_file"
          # A relative ENV_FILE in a conf file is relative to that file.
          case "$env_file" in '' | /* | [A-Za-z]:*) ;; *) env_file="$(dirname "$conf")/$env_file" ;; esac
          ;;
      esac
    fi
    [ -n "$name" ] || die "setup needs a demo name: lilypad setup <name> ... (or NAME= in the conf file)"
    case "$name" in -*) die "setup needs a demo name first: lilypad setup <name> --repo <url> ..." ;; esac
    [ -n "$repo" ] || die "setup needs --repo https://github.com/<org>/<repo> (or REPO= in the conf file)"
    env_text=""
    if [ -n "$env_file" ]; then
      [ -r "$env_file" ] || die "cannot read $env_file"
      env_text="$(cat "$env_file")"
    fi
    # GitHub access never goes on the command line (shell history, ps): a PAT, a deploy key file path, or
    # "public". Blank keeps the one already stored, except on a destroyed name. The server works out which it is.
    pat="${GITHUB_AUTH:-${GITHUB_PAT:-}}"
    if [ -z "$pat" ] && [ -t 0 ]; then
      read -r -s -p "GitHub access: PAT, path to a deploy key file, or public (blank keeps the stored one): " pat
      echo >&2
    fi
    # shellcheck disable=SC2088  # matching a literal ~/ that the shell did not expand
    case "$pat" in "~/"*) pat="$HOME/${pat#"~/"}" ;; esac
    if [ -n "$pat" ] && [ -f "$pat" ]; then
      [ -r "$pat" ] || die "cannot read $pat"
      grep -q "PRIVATE KEY-----" "$pat" || die "$pat is not a private key (use the deploy key file without .pub)"
      pat="$(cat "$pat")"
    fi
    # Notes are sent only when given (option or NOTES=), so leaving them out keeps the stored ones; "" clears.
    case "$o_seen" in *" notes "*) has_notes=true ;; *) has_notes=false ;; esac
    notes="${notes//\\n/$'\n'}"
    body="$(jq -nc --arg name "$name" --arg repo "$repo" --arg client "$client" --arg branch "$branch" \
      --arg port "$port" --arg health "$health" --arg size "$size" --arg env "$env_text" --arg pat "$pat" \
      --arg notes "$notes" --argjson has_notes "$has_notes" '
      {action: "setup", name: $name, args:
        (({repoUrl: $repo, client: $client, branch: $branch, port: $port, healthPath: $health, size: $size,
           env: $env, githubPat: $pat}
          | with_entries(select(.value != ""))) + (if $has_notes then {notes: $notes} else {} end))}')"
    ;;
  *) die "unknown command '$action' (see: lilypad --help)" ;;
esac

# --- call ------------------------------------------------------------------------

url="${LILYPAD_URL:-$( [ -r "$url_file" ] && head -n1 "$url_file" || true)}"
[ -n "$url" ] || die "no platform URL configured: run 'lilypad config url <URL>' (or re-run the installer)"
key="${LILYPAD_KEY:-$( [ -r "$key_file" ] && cat "$key_file" || true)}"

# Headers (including the key) go through a curl config on stdin so they never appear in `ps`.
out="$(
  {
    echo 'header = "Content-Type: application/json"'
    if [ -n "$key" ]; then echo "header = \"X-Lilypad-Key: $key\""; fi
  } | curl -sS -X POST "$url" -K - -d "$body" -w $'\n%{http_code}'
)"
code="${out##*$'\n'}"
resp="${out%$'\n'*}"

if command -v jq >/dev/null && jq -e . >/dev/null 2>&1 <<<"$resp"; then
  jq . <<<"$resp"
else
  echo "$resp"
fi

case "$code" in
  2??)
    if [ "$action" = auth ]; then
      echo "lilypad: check your inbox, and your spam/junk folder, for the key (from \"Lilypad\"). Then run: lilypad login <key>" >&2
    fi
    ;;
  401) die "HTTP 401: run 'lilypad auth you@$email_domain', then 'lilypad login <key>'" ;;
  *) die "HTTP $code" ;;
esac
